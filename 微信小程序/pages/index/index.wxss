/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* ============ 顶部横幅 ============ */
.banner {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(27, 108, 255, 0.25);
}
.banner-img {
  width: 100%;
  height: 240rpx;
  display: block;
}
.banner-mask {
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(10, 40, 90, 0.78) 0%, rgba(10, 40, 90, 0.25) 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 34rpx;
}
.banner-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.banner-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  margin-top: 10rpx;
}
.status-pill {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 40rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.status-pill .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.status-pill.online { color: #00b578; }
.status-pill.online .dot { background: #00b578; box-shadow: 0 0 10rpx #00b578; }
.status-pill.offline { color: #999; }
.status-pill.offline .dot { background: #ccc; }

/* ============ 门锁状态主卡 ============ */
.door-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border-top: 6rpx solid #e64340;
}
.door-card.opened {
  border-top-color: #00b578;
}
.door-img {
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
}
.door-info {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  flex: 1;
}
.door-state {
  font-size: 34rpx;
  font-weight: 700;
  color: #26323f;
}
.door-last {
  font-size: 24rpx;
  color: #7a8694;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.badge {
  background: #f0f2f5;
  color: #7a8694;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.badge.ok { background: #e6f7f0; color: #00b578; }
.badge.fail { background: #fdecec; color: #e64340; }

/* ============ 物模型数据网格 ============ */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.grid-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 22rpx 10rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}
.grid-title {
  font-size: 21rpx;
  color: #8b95a1;
  margin-bottom: 10rpx;
}
.grid-value {
  font-size: 27rpx;
  font-weight: 700;
  color: #26323f;
  white-space: nowrap;
}
.grid-item.lock { border-bottom: 5rpx solid #1b6cff; }
.grid-item.auth { border-bottom: 5rpx solid #8e5df1; }
.grid-item.result { border-bottom: 5rpx solid #ffb400; }
.grid-item.face { border-bottom: 5rpx solid #00c2b8; }

/* ============ 区块标题 ============ */
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #26323f;
  padding-left: 6rpx;
}

/* ============ 控制卡片 ============ */
.ctrl-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}
.ctrl-text { flex: 1; }
.ctrl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #26323f;
}
.ctrl-desc {
  font-size: 22rpx;
  color: #98a2ae;
  margin-top: 8rpx;
}
.ctrl-divider {
  height: 1rpx;
  background: #f0f2f5;
}
.btn {
  margin: 0;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0 44rpx;
}
.btn::after { border: none; }
.btn-primary {
  background: linear-gradient(135deg, #1b6cff, #4f9bff);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(27, 108, 255, 0.35);
}
.btn-danger {
  background: #fff1f0;
  color: #e64340;
  box-shadow: none;
}
.btn-set { padding: 0 34rpx; }

/* 密码行 */
.pwd-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 6rpx 0 30rpx;
}
.pwd-input {
  flex: 1;
  background: #f5f7fa;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  letter-spacing: 8rpx;
  box-sizing: border-box;
}
.pwd-ph {
  letter-spacing: 0;
  color: #b9c2cd;
}

/* ============ 门禁动态 ============ */
.log-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 30rpx;
}
.log-empty {
  text-align: center;
  color: #b9c2cd;
  font-size: 24rpx;
  padding: 30rpx 0;
}
.log-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}
.log-item:last-child { border-bottom: none; }
.log-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #c3cbd6;
}
.log-dot.ok { background: #00b578; box-shadow: 0 0 8rpx rgba(0, 181, 120, 0.6); }
.log-dot.fail { background: #e64340; box-shadow: 0 0 8rpx rgba(230, 67, 64, 0.6); }
.log-text {
  flex: 1;
  font-size: 26rpx;
  color: #3c4652;
}
.fail-text { color: #e64340; }
.log-time {
  font-size: 20rpx;
  color: #b9c2cd;
  flex-shrink: 0;
}

/* 小屏适配 */
@media (max-width: 600rpx) {
  .grid { grid-template-columns: repeat(2, 1fr); }
}
